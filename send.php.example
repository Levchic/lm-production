<?php
/**
 * ШАБЛОН. Рабочий файл send.php в репозиторий не выкладывается (см. .gitignore),
 * потому что в нём лежит токен бота. Чтобы поднять формы на PHP-хостинге:
 *   1) скопируйте этот файл в send.php
 *   2) впишите TELEGRAM_TOKEN (от @BotFather) и TELEGRAM_CHAT_ID
 * На GitHub Pages этот файл НЕ РАБОТАЕТ: Pages отдаёт только статику, PHP там не выполняется.
 *
 * ПРИЁМ ЗАЯВОК И ОТЗЫВОВ → TELEGRAM
 * =================================
 * Единственный серверный файл сайта. Работает на обычном хостинге с PHP
 * (например, на виртуальном хостинге reg.ru) — база данных не нужна,
 * ничего на сервере не сохраняется: сообщение сразу уходит в Telegram.
 *
 * ВАЖНО: в этом файле лежит токен бота. Файл исполняется сервером и
 * посетителю его содержимое не отдаётся, но пересылать его кому-либо
 * или выкладывать в открытый репозиторий нельзя. Если токен утёк —
 * отзовите его в @BotFather (/revoke) и впишите сюда новый.
 */

// ------------------------------------------------------------- настройки
const TELEGRAM_TOKEN = 'ВСТАВЬТЕ_ТОКЕН_ОТ_BOTFATHER';

// Куда присылать сообщения. Это ваш личный chat_id: чтобы его получить,
// напишите боту @note_parse_bot команду /start и запустите
//   node server/telegram-setup.js
// — скрипт сам подставит сюда нужное число.
const TELEGRAM_CHAT_ID = '';

// Максимум обращений с одного IP за час — простая защита от спама.
const RATE_LIMIT_PER_HOUR = 5;

// ------------------------------------------------------------- служебное
header('Content-Type: application/json; charset=utf-8');
header('Cache-Control: no-store');

function fail($message, $code = 400) {
    http_response_code($code);
    echo json_encode(['ok' => false, 'error' => $message], JSON_UNESCAPED_UNICODE);
    exit;
}

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
    fail('Ожидается POST', 405);
}

$raw = file_get_contents('php://input');
if (strlen($raw) > 20000) {
    fail('Слишком длинное сообщение');
}
$data = json_decode($raw, true);
if (!is_array($data)) {
    fail('Не удалось разобрать запрос');
}

/** Чистим текст: убираем управляющие символы и ограничиваем длину. */
function clean($value, $max) {
    $text = is_string($value) ? $value : '';
    $text = preg_replace('/[\x00-\x08\x0B\x0C\x0E-\x1F]/u', '', $text);
    $text = trim($text);
    return mb_substr($text, 0, $max, 'UTF-8');
}

// Ловушка для ботов: живой человек это поле не видит и не заполняет.
if (clean($data['website'] ?? '', 100) !== '') {
    echo json_encode(['ok' => true], JSON_UNESCAPED_UNICODE);
    exit;
}

// Простой ограничитель по IP: счётчик в системной временной папке.
$ip = $_SERVER['REMOTE_ADDR'] ?? 'unknown';
$bucket = sys_get_temp_dir() . '/lm-form-' . md5($ip) . '.txt';
$hits = [];
if (is_readable($bucket)) {
    $hits = array_filter(explode(',', (string)file_get_contents($bucket)), function ($t) {
        return is_numeric($t) && (time() - (int)$t) < 3600;
    });
}
if (count($hits) >= RATE_LIMIT_PER_HOUR) {
    fail('Слишком много обращений подряд. Попробуйте позже.', 429);
}
$hits[] = time();
@file_put_contents($bucket, implode(',', $hits));

// ------------------------------------------------------------- сообщение
$type = ($data['type'] ?? '') === 'review' ? 'review' : 'lead';

if ($type === 'review') {
    $name = clean($data['name'] ?? '', 80);
    $text = clean($data['text'] ?? '', 1500);
    if ($name === '' || $text === '' || ($data['consent'] ?? false) !== true) {
        fail('Заполните имя, текст отзыва и согласие на публикацию');
    }
    $rating = max(0, min(5, (int)($data['rating'] ?? 0)));
    $lines = [
        '🌟 <b>Новый отзыв с сайта</b>',
        '',
        '<b>Имя:</b> ' . htmlspecialchars($name, ENT_QUOTES, 'UTF-8'),
    ];
    $role = clean($data['role'] ?? '', 120);
    if ($role !== '') $lines[] = '<b>Кем работает:</b> ' . htmlspecialchars($role, ENT_QUOTES, 'UTF-8');
    if ($rating > 0) $lines[] = '<b>Оценка:</b> ' . str_repeat('★', $rating) . str_repeat('☆', 5 - $rating);
    $profile = clean($data['profileUrl'] ?? '', 200);
    if ($profile !== '' && preg_match('~^https://(vk\.com|m\.vk\.ru|vk\.ru|t\.me|telegram\.me)/[\w./-]+$~i', $profile)) {
        $lines[] = '<b>Профиль:</b> ' . htmlspecialchars($profile, ENT_QUOTES, 'UTF-8');
    }
    $lines[] = '';
    $lines[] = htmlspecialchars($text, ENT_QUOTES, 'UTF-8');
    $lines[] = '';
    $lines[] = '<i>Чтобы отзыв появился на сайте, добавьте его в админке: раздел «Отзывы».</i>';
} else {
    $name = clean($data['name'] ?? '', 80);
    $contact = clean($data['contact'] ?? '', 120);
    $message = clean($data['message'] ?? '', 3000);
    if ($name === '' || $contact === '' || $message === '' || ($data['consent'] ?? false) !== true) {
        fail('Заполните имя, контакт, описание задачи и согласие на обработку данных');
    }
    $lines = [
        '📩 <b>Заявка с сайта</b>',
        '',
        '<b>Имя:</b> ' . htmlspecialchars($name, ENT_QUOTES, 'UTF-8'),
        '<b>Контакт:</b> ' . htmlspecialchars($contact, ENT_QUOTES, 'UTF-8'),
    ];
    $service = clean($data['service'] ?? '', 120);
    if ($service !== '') $lines[] = '<b>Услуга:</b> ' . htmlspecialchars($service, ENT_QUOTES, 'UTF-8');
    $lines[] = '';
    $lines[] = htmlspecialchars($message, ENT_QUOTES, 'UTF-8');
}

$lang = ($data['lang'] ?? 'ru') === 'en' ? 'en' : 'ru';
if ($lang === 'en') $lines[] = "\n<i>(отправлено из английской версии сайта)</i>";

// ------------------------------------------------------------- отправка
if (TELEGRAM_CHAT_ID === '') {
    fail('Форма ещё не настроена: не указан TELEGRAM_CHAT_ID в send.php', 500);
}

$payload = http_build_query([
    'chat_id' => TELEGRAM_CHAT_ID,
    'text' => implode("\n", $lines),
    'parse_mode' => 'HTML',
    'disable_web_page_preview' => true,
]);

$url = 'https://api.telegram.org/bot' . TELEGRAM_TOKEN . '/sendMessage';
$response = false;

if (function_exists('curl_init')) {
    $ch = curl_init($url);
    curl_setopt_array($ch, [
        CURLOPT_POST => true,
        CURLOPT_POSTFIELDS => $payload,
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT => 15,
    ]);
    $response = curl_exec($ch);
    curl_close($ch);
} else {
    $context = stream_context_create(['http' => [
        'method' => 'POST',
        'header' => "Content-Type: application/x-www-form-urlencoded\r\n",
        'content' => $payload,
        'timeout' => 15,
    ]]);
    $response = @file_get_contents($url, false, $context);
}

$result = json_decode((string)$response, true);
if (!is_array($result) || empty($result['ok'])) {
    fail('Не удалось отправить сообщение. Напишите, пожалуйста, в Telegram или ВКонтакте.', 502);
}

echo json_encode(['ok' => true], JSON_UNESCAPED_UNICODE);
